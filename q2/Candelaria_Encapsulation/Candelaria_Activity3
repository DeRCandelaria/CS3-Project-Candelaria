class BankAccount:

    def __init__(self, account_number: int, balance: float):
        self.set_account_number(account_number)
        self.set_balance(balance)

    def set_account_number(self, account_number: int):
        self.__account_number = account_number

    def set_balance(self, balance: float):
        if balance < 0:
            print("The balance must be not be a negative number.")
        else:
            self.__balance = balance

    @property
    def account_number(self) -> int:
        return self.__account_number

    @property
    def balance(self) -> float:
        return self.__balance

    def get_account_number(self) -> int:
        return self.account_number

    def get_balance(self) -> float:
        return self.balance


a1 = BankAccount(12345, 10**6)

print("Account 1")
print(f"Account Number: {a1.get_account_number()}")
print(f"Balance: {a1.get_balance():.2f}\n")

print("Update balance to -100")
a1.set_balance(100)

print(f"Account Number: {a1.get_account_number()}")
print(f"Balance: {a1.get_balance():.2f}")